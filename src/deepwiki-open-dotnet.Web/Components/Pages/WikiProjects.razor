@page "/wiki"
@using deepwiki_open_dotnet.Web.Components.Shared
@using deepwiki_open_dotnet.Web.Models
@using deepwiki_open_dotnet.Web.Services
@inject WikiApiClient WikiApi
@inject ChatApiClient ChatApi
@inject NavigationManager Navigation
@namespace deepwiki_open_dotnet.Web.Components.Pages
@implements IAsyncDisposable

@* T034 – US2: Wiki project browser page *@
@* T060 – US5: Add wiki generation trigger *@

<PageTitle>Wiki Projects</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <div class="d-flex align-items-center justify-content-between mb-2">
        <MudText Typo="Typo.h4">Wiki Projects</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   OnClick="OpenGenerateDialog"
                   Disabled="@_isDialogOpen">
            Generate Wiki
        </MudButton>
    </div>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Browse all generated wiki projects. Click a project to view its pages.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_generateError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _generateError = null)">
            @_generateError
        </MudAlert>
    }

    <WikiProjectList Projects="@_projects"
                     TotalCount="@_totalCount"
                     IsLoading="@_isLoading"
                     Page="@_currentPage"
                     PageSize="@PageSize"
                     OnProjectClick="NavigateToWiki"
                     OnPageChange="LoadPageAsync" />

</MudContainer>

@* ── Generate Wiki Dialog ──────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_isDialogOpen" Options="@_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-2" />
            Generate Wiki from Collection
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">

            @* Collection selector *@
            <MudSelect T="string"
                       Label="Collection"
                       @bind-Value="_selectedCollectionId"
                       Required="true"
                       RequiredError="Please select a collection."
                       Variant="Variant.Outlined"
                       HelperText="Choose the document collection to generate a wiki from."
                       Disabled="@_isGenerating">
                @foreach (var col in _collections)
                {
                    <MudSelectItem T="string" Value="@col.Id">@col.Name</MudSelectItem>
                }
            </MudSelect>

            @* Wiki name *@
            <MudTextField T="string"
                          Label="Wiki Name"
                          @bind-Value="_wikiName"
                          Required="true"
                          RequiredError="Wiki name is required."
                          MaxLength="200"
                          Counter="200"
                          Variant="Variant.Outlined"
                          HelperText="A short, descriptive name for the wiki."
                          Disabled="@_isGenerating" />

            @* Description *@  
            <MudTextField T="string"
                          Label="Description (optional)"
                          @bind-Value="_wikiDescription"
                          MaxLength="500"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Disabled="@_isGenerating" />

            @if (_isGenerating || _dialogProgressEvents.Count > 0)
            {
                <WikiGenerationProgress WikiName="@_wikiName"
                                        Events="@_dialogProgressEvents"
                                        TotalPages="@_dialogTotalPages"
                                        IsComplete="@_dialogGenerationComplete"
                                        IsFailed="false"
                                        IsCancelling="false"
                                        CurrentPageTokenCount="@_currentPageTokenCount" />
                <div class="d-flex justify-space-between align-center mt-1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Elapsed: @_elapsedDisplay
                    </MudText>
                    @if (_generationWikiId.HasValue && !_dialogGenerationComplete)
                    {
                        <MudLink Href="@($"/wiki/{_generationWikiId}")" Typo="Typo.caption">
                            View partial wiki →
                        </MudLink>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_dialogError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_dialogError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_isGenerating)
        {
            <MudButton OnClick="CloseDialog" Color="Color.Warning" Variant="Variant.Outlined">
                Stop Generation
            </MudButton>
        }
        else
        {
            <MudButton OnClick="CloseDialog">
                @(_dialogGenerationComplete || (_generationWikiId.HasValue && _dialogProgressEvents.Count > 0) ? "Close" : "Cancel")
            </MudButton>
            @if (_dialogProgressEvents.Count == 0)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="StartGenerationAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_selectedCollectionId) || string.IsNullOrWhiteSpace(_wikiName))">
                    Generate
                </MudButton>
            }
            @if (_generationWikiId.HasValue)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="NavigateToGeneratedWiki">
                    Open Wiki
                </MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<WikiSummaryDto> _projects = [];
    private int _totalCount;
    private bool _isLoading = true;
    private int _currentPage = 1;

    private const int PageSize = 20;

    // ── Generate dialog state ─────────────────────────────────────────────────
    private bool _isDialogOpen;
    private bool _isGenerating;
    private string _selectedCollectionId = string.Empty;
    private string _wikiName = string.Empty;
    private string? _wikiDescription;
    private string? _dialogError;
    private string? _generateError;
    private List<DocumentCollectionModel> _collections = [];
    private CancellationTokenSource? _generateCts;

    // ── Live generation progress (collected while dialog is open) ───────────
    private List<WikiGenerationProgressDto> _dialogProgressEvents = [];
    private int _dialogTotalPages;
    private bool _dialogGenerationComplete;
    private Guid? _generationWikiId;
    private string _elapsedDisplay = "0:00";
    private System.Threading.Timer? _elapsedTimer;
    private DateTime _generateStartTime;
    private int _currentPageTokenCount;  // resets on each page_start

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadPageAsync(_currentPage),
            LoadCollectionsAsync());
    }

    private async Task LoadPageAsync(int page)
    {
        _isLoading = true;
        _currentPage = page;

        try
        {
            var result = await WikiApi.GetProjectsAsync(page, PageSize);
            _projects = result.Items;
            _totalCount = result.TotalCount;
        }
        catch
        {
            _projects = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            var result = await ChatApi.GetCollectionsAsync();
            _collections = result.Collections;
        }
        catch
        {
            _collections = [];
        }
    }

    private void NavigateToWiki(Guid wikiId)
    {
        Navigation.NavigateTo($"/wiki/{wikiId}");
    }

    private void OpenGenerateDialog()
    {
        _selectedCollectionId = string.Empty;
        _wikiName = string.Empty;
        _wikiDescription = null;
        _dialogError = null;
        _isGenerating = false;
        _dialogProgressEvents = [];
        _dialogTotalPages = 0;
        _dialogGenerationComplete = false;
        _generationWikiId = null;
        _elapsedDisplay = "0:00";
        _currentPageTokenCount = 0;
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        _generateCts?.Cancel();
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
        _isDialogOpen = false;
        _isGenerating = false;
    }

    private void NavigateToGeneratedWiki()
    {
        if (_generationWikiId.HasValue)
        {
            _isDialogOpen = false;
            Navigation.NavigateTo($"/wiki/{_generationWikiId}");
        }
    }

    private void StartElapsedTimer()
    {
        _generateStartTime = DateTime.UtcNow;
        _elapsedTimer?.Dispose();
        _elapsedTimer = new System.Threading.Timer(async _ =>
        {
            var elapsed = DateTime.UtcNow - _generateStartTime;
            _elapsedDisplay = elapsed.TotalHours >= 1
                ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
                : $"{elapsed.Minutes}:{elapsed.Seconds:D2}";
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task StartGenerationAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedCollectionId) || string.IsNullOrWhiteSpace(_wikiName))
            return;

        _isGenerating = true;
        _dialogError = null;
        _dialogProgressEvents = [];
        _dialogTotalPages = 0;
        _dialogGenerationComplete = false;
        _generationWikiId = null;
        StateHasChanged();

        StartElapsedTimer();

        _generateCts?.Cancel();
        _generateCts = new CancellationTokenSource();
        var ct = _generateCts.Token;

        try
        {
            await foreach (var evt in WikiApi.GenerateWikiAsync(
                new { collectionId = _selectedCollectionId, name = _wikiName, description = _wikiDescription },
                ct))
            {
                // page_token: increment counter; throttle re-renders to every 25 tokens
                if (evt.EventType == WikiGenerationProgressDto.PageToken)
                {
                    _currentPageTokenCount++;
                    if (_currentPageTokenCount % 25 != 0)
                        continue;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                // toc_token: keep only the latest in the events list so the component
                // status text updates without accumulating thousands of entries
                if (evt.EventType == WikiGenerationProgressDto.TocToken)
                {
                    _dialogProgressEvents = _dialogProgressEvents
                        .Where(e => e.EventType != WikiGenerationProgressDto.TocToken)
                        .Append(evt)
                        .ToList();
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                // All other events go into the list normally
                _dialogProgressEvents = [.._dialogProgressEvents, evt];

                switch (evt.EventType)
                {
                    case WikiGenerationProgressDto.WikiCreated:
                        _generationWikiId = evt.WikiId == Guid.Empty ? null : (Guid?)evt.WikiId;
                        break;

                    case WikiGenerationProgressDto.PageStart:
                        _currentPageTokenCount = 0;
                        break;

                    case WikiGenerationProgressDto.TocComplete:
                        _dialogTotalPages = evt.TotalPages;
                        break;

                    case WikiGenerationProgressDto.GenerationComplete:
                        _dialogGenerationComplete = true;
                        _elapsedTimer?.Dispose();
                        _elapsedTimer = null;
                        await InvokeAsync(StateHasChanged);
                        // Brief pause so the user sees the completion banner, then navigate
                        await Task.Delay(1800, CancellationToken.None);
                        _isDialogOpen = false;
                        Navigation.NavigateTo($"/wiki/{evt.WikiId}");
                        return;

                    case WikiGenerationProgressDto.GenerationCancelled:
                        _elapsedTimer?.Dispose();
                        _elapsedTimer = null;
                        await InvokeAsync(StateHasChanged);
                        return;
                }

                await InvokeAsync(StateHasChanged);
            }

            // Stream ended without a terminal event
            if (!_dialogGenerationComplete && !_generationWikiId.HasValue)
                _dialogError = "Generation did not produce a wiki. Please try again.";
        }
        catch (OperationCanceledException)
        {
            // User stopped generation via Stop Generation button
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _dialogError = "A wiki with this name is already being generated for this collection.";
        }
        catch (Exception ex)
        {
            _dialogError = $"Generation failed: {ex.Message}";
        }
        finally
        {
            _elapsedTimer?.Dispose();
            _elapsedTimer = null;
            _isGenerating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public ValueTask DisposeAsync()
    {
        _generateCts?.Cancel();
        _generateCts?.Dispose();
        _elapsedTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
