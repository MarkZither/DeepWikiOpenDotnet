@using deepwiki_open_dotnet.Web.Models
@namespace deepwiki_open_dotnet.Web.Components.Shared

@* T033 – US2: Paginated wiki project list component *@

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (Projects == null || !Projects.Any())
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        No wiki projects found. Create one via the <strong>POST /api/wiki</strong> endpoint or use the Generate Wiki feature (coming soon).
    </MudAlert>
}
else
{
    <MudTable T="WikiSummaryDto"
              Items="@_pagedItems"
              Hover="true"
              Dense="true"
              SortLabel="Sort By"
              aria-label="Wiki project list"
              Class="mt-2">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<WikiSummaryDto, object>(x => x.Name)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<WikiSummaryDto, object>(x => x.CollectionSource)">Collection</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<WikiSummaryDto, object>(x => x.PageCount)">Pages</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<WikiSummaryDto, object>(x => x.LastModified)">Last Modified</MudTableSortLabel>
            </MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudLink OnClick="@(() => HandleRowClick(context))" Style="cursor:pointer;">
                    @context.Name
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Collection">
                <MudTooltip Text="@context.CollectionSource">
                    <span class="text-truncate" style="max-width:200px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                        @context.CollectionSource
                    </span>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Pages">@context.PageCount</MudTd>
            <MudTd DataLabel="Last Modified">@context.LastModified.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small"
                         Color="@StatusColor(context.Status)">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>

    </MudTable>

    @if (TotalCount > PageSize)
    {
        <div class="d-flex justify-center mt-4">
            <MudPagination Count="@TotalPages"
                           Selected="@_currentPage"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary"
                           ShowFirstButton="true"
                           ShowLastButton="true" />
        </div>
    }
}

@code {
    /// <summary>Projects for the current page.</summary>
    [Parameter] public IReadOnlyList<WikiSummaryDto> Projects { get; set; } = [];

    /// <summary>Total number of wiki projects across all pages.</summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>Whether a load operation is in progress.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Current page number (1-based).</summary>
    [Parameter] public int Page { get; set; } = 1;

    /// <summary>Number of items per page.</summary>
    [Parameter] public int PageSize { get; set; } = 20;

    /// <summary>Fired when the user clicks on a project row, passing the wiki ID.</summary>
    [Parameter] public EventCallback<Guid> OnProjectClick { get; set; }

    /// <summary>Fired when the user changes page.</summary>
    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    private int _currentPage = 1;
    private int TotalPages => PageSize > 0 ? (int)Math.Ceiling((double)TotalCount / PageSize) : 1;

    // When Projects is supplied externally (already paged from parent), show them all.
    private IReadOnlyList<WikiSummaryDto> _pagedItems => Projects;

    protected override void OnParametersSet()
    {
        _currentPage = Page;
    }

    private async Task HandleRowClick(WikiSummaryDto project)
    {
        if (OnProjectClick.HasDelegate)
            await OnProjectClick.InvokeAsync(project.Id);
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        if (OnPageChange.HasDelegate)
            await OnPageChange.InvokeAsync(page);
    }

    private static Color StatusColor(string status) => status switch
    {
        "Complete"   => Color.Success,
        "Generating" => Color.Info,
        "Partial"    => Color.Warning,
        "Error"      => Color.Error,
        _            => Color.Default
    };
}
